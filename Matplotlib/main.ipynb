    "import matplotlib.pyplot as plt\n",
    "\n",
    "students = [\"Sammy\", \"John\", \"Mary\", \"David\", \"Sarah\"]\n",
    "scores = [75, 82, 68, 90, 85]\n",
    "\n",
    "plt.bar(students, scores, color=\"green\")\n",
    "\n",
    "plt.title(\"Exam Scores\")\n",
    "plt.xlabel(\"Students\")\n",
    "plt.ylabel(\"Scores\")\n",
    "\n",
    "plt.show()\n"
   ]
