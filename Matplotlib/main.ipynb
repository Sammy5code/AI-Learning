    "\n",
    "plt.scatter(hours, scores, color=\"green\")\n",
    "\n",
    "plt.title(\"Exam Scores\")\n",
    "plt.xlabel(\"Hours\")\n",
    "plt.ylabel(\"Scores\")\n",
    "\n",
    "plt.show()\n"
   ]
